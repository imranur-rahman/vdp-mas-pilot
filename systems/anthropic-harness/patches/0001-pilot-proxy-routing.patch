+def _pilot_role(name: str) -> str:
+    """The pilot role an agent container's name maps to, for per-role proxy keys.
+    Order matters: the patch grader ('pgrade', '*_grade_it*') is told apart from
+    the find grader ('grader_*') before the generic 'grad' test."""
+    n = name.lower()
+    if "pgrade" in n or "_grade_it" in n:
+        return "patch-grade"
+    if "grad" in n:
+        return "grade"
+    for role in ("recon", "judge", "report", "patch", "find"):
+        if role in n:
+            return role
+    return "find"
+
+
+def _pilot_route(name: str, auth: dict[str, str] | None) -> dict[str, str] | None:
+    """vdp-mas-pilot (P3(a) model routing, D2 role labeling): point each agent's
+    ``claude -p`` at the LiteLLM proxy with the per-role virtual key that labels
+    its calls as finder, grader, reporter, patcher, etc. No-op unless the pilot
+    env is set, so upstream behaviour is unchanged outside the pilot."""
+    base = os.environ.get("PILOT_PROXY_URL")
+    if not base or auth is None:
+        return auth
+    import json as _json
+    keys = _json.loads(os.environ.get("PILOT_ROLE_KEYS") or "{}")
+    role = _pilot_role(name)
+    e = dict(auth)
+    e["ANTHROPIC_BASE_URL"] = base
+    if role in keys:
+        e.pop("CLAUDE_CODE_OAUTH_TOKEN", None)
+        e["ANTHROPIC_API_KEY"] = keys[role]
+    return e
+
