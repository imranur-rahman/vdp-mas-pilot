  "threat_model": {
    "system_context": "MD4C is a C library (src/md4c.c, md4c.h, md4c-html.c, md4c-html.h, entity.c, entity.h) that parses CommonMark-style Markdown from a caller-supplied byte buffer and calls back into the host application, plus an HTML renderer built on it. It is embedded as a library, not a network service. Untrusted Markdown input is the primary data entering the process, and the library's callers decide whether that input is trusted. Build and CI are CMake plus Travis/AppVeyor with -Werror and coverage. No dependency manifests, no API contract artefacts and no runtime configuration were present in the snapshot.",
    "assets": [
      {
        "name": "host process memory",
