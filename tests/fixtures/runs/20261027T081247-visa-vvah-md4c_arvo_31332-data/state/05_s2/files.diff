+	else
+		printf '%s hits; sample:\n' "$(printf '%s\n' "$_out" | wc -l | tr -d ' ')"
+		printf '%s\n' "$_out" | head -n 3 | cut -c1-$WIDTH
+	fi
+	echo ""
+}
+
+PY='*.py *.pyi'
+JS='*.js *.jsx *.ts *.tsx *.mjs *.cjs *.vue *.svelte'
+JV='*.java *.kt *.kts *.scala *.groovy'
+RB='*.rb *.rake *.erb Gemfile Rakefile'
+PH='*.php *.phtml *.inc'
+GO='*.go'
+NET='*.cs *.vb *.fs *.fsx'
