+	'(disabled[[:space:]]*=|readOnly|readonly|type=["'"'"']hidden["'"'"']|maxLength|minLength|pattern=|[[:space:]]required[[:space:]>/]|step=["'"'"']|yup\.|zod|z\.object|Joi\.|useForm\()' 12
+
