+
+hits "SQL text with interpolation or concatenation" \
+	'(SELECT|INSERT[[:space:]]+INTO|UPDATE|DELETE[[:space:]]+FROM)[^;]*(\+|%s|%d|\.format\(|\{[A-Za-z_])'
+hits "execute/query/raw on a non-literal argument" \
