+    { "&yacute;", { 253, 0 } },
+    { "&yacy;", { 1103, 0 } },
+    { "&ycirc;", { 375, 0 } },
+    { "&ycy;", { 1099, 0 } },
+    { "&yen;", { 165, 0 } },
+    { "&yfr;", { 120118, 0 } },
+    { "&yicy;", { 1111, 0 } },
+    { "&yopf;", { 120170, 0 } },
+    { "&yscr;", { 120014, 0 } },
+    { "&yucy;", { 1102, 0 } },
+    { "&yuml;", { 255, 0 } },
+    { "&zacute;", { 378, 0 } },
+    { "&zcaron;", { 382, 0 } },
+    { "&zcy;", { 1079, 0 } },
+    { "&zdot;", { 380, 0 } },
+    { "&zeetrf;", { 8488, 0 } },
+    { "&zeta;", { 950, 0 } },
+    { "&zfr;", { 120119, 0 } },
+    { "&zhcy;", { 1078, 0 } },
+    { "&zigrarr;", { 8669, 0 } },
+    { "&zopf;", { 120171, 0 } },
+    { "&zscr;", { 120015, 0 } },
+    { "&zwj;", { 8205, 0 } },
+    { "&zwnj;", { 8204, 0 } }
+};
+
+
+struct entity_key {
+    const char* name;
+    size_t name_size;
+};
+
+static int
+entity_cmp(const void* p_key, const void* p_entity)
+{
+    struct entity_key* key = (struct entity_key*) p_key;
+    struct entity* ent = (struct entity*) p_entity;
+
+    return strncmp(key->name, ent->name, key->name_size);
+}
+
+const struct entity*
+entity_lookup(const char* name, size_t name_size)
+{
+    struct entity_key key = { name, name_size };
+
+    return bsearch(&key,
+                   entity_table,
+                   sizeof(entity_table) / sizeof(entity_table[0]),
+                   sizeof(struct entity),
+                   entity_cmp);
+}
